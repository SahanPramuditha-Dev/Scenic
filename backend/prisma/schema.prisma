generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                  String   @id @default(uuid())
  firebaseUid         String   @unique
  email               String?  @unique
  username            String?  @unique
  displayName         String?
  avatarUrl           String?
  onboardingComplete  Boolean  @default(false)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
  // Relations
  watchlists          WatchlistItem[]
  history             HistoryItem[]
  animeWatchlists      AnimeWatchlistItem[]
  animeHistory         AnimeHistoryItem[]

  @@map("users")
}

model WatchlistItem {
  id        String   @id @default(uuid())
  userId    String
  tmdbId    Int
  mediaType String   // "movie" or "tv"
  addedAt   DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, tmdbId, mediaType])
  @@map("watchlist_items")
}

model HistoryItem {
  id        String   @id @default(uuid())
  userId    String
  tmdbId    Int
  mediaType String   // "movie" or "tv"
  rating    Int?     // 1-10
  status    String   @default("completed")
  season    Int?
  episode   Int?
  watchedAt DateTime @default(now())
  
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, tmdbId, mediaType])
  @@map("history_items")
}

model AnimeWatchlistItem {
  id        String   @id @default(uuid())
  userId    String
  anilistId Int
  addedAt   DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, anilistId])
  @@map("anime_watchlist_items")
}

model AnimeHistoryItem {
  id        String   @id @default(uuid())
  userId    String
  anilistId Int
  rating    Int?
  status    String   @default("completed")
  episodesWatched Int @default(0)
  watchedAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, anilistId])
  @@map("anime_history_items")
}
