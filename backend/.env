PORT=3000
# Update this with your Docker PostgreSQL connection string once docker is running, 
# or local postgres if running locally. For docker-compose, if backend is in docker:
# DATABASE_URL="postgresql://postgres:postgres@db:5432/scenic?schema=public"
# For running backend on host and DB in docker:
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/scenic?schema=public"

# TMDB API
TMDB_ACCESS_TOKEN="1234"
TMDB_BASE_URL="https://api.themoviedb.org/3"
